# Shared tool versions and images for CI and local development.
# Committed configuration; do not put credentials here.

# Match init.sh so local and CI formatting use the same Just release.
JUST_VERSION=1.59.0

# Use images published and documented by each tool's own project.
# Exact tags identify versions; multi-architecture digests pin their contents.
# Keep native Ruff/Trivy versions aligned with their local image tags.
# ShellCheck/actionlint image pins also appear literally in ci.yml's uses fields.
# https://docs.astral.sh/ruff/installation/
RUFF_VERSION=0.17.1
RUFF_IMAGE=ghcr.io/astral-sh/ruff:0.17.1@sha256:eae3102808b46de58204237a3433001cae4d45d832f31be1c8121f7145a62661
# https://github.com/koalaman/shellcheck#installing
SHELLCHECK_IMAGE=koalaman/shellcheck:v0.11.0@sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d
# https://github.com/rhysd/actionlint/blob/main/docs/usage.md#docker-image
ACTIONLINT_IMAGE=rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
# https://trivy.dev/docs/latest/getting-started/installation/#container-image-official
TRIVY_VERSION=0.76.0
TRIVY_IMAGE=aquasec/trivy:0.76.0@sha256:2416d1f74045b57274df1a340eee6b510cacd73c66a6ccb8da092b117eb7d222

# Cluster tools run on the host to use Docker and kubeconfig directly.
KIND_VERSION=0.33.0
KUBECTL_VERSION=1.37.1
HELM_VERSION=4.3.1
# Use a node image built and tested for this Kind release.
# https://github.com/kubernetes-sigs/kind/releases/tag/v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
